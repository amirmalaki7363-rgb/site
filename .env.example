# Copy to .env and fill in. NEVER commit .env.
DATABASE_URL="file:./db/custom.db"
# >= 32 random chars (e.g. `openssl rand -hex 32`). Required in production.
AUTH_SECRET=
# Public origin of the site (used for canonical URLs, sitemap, payment callbacks)
SITE_URL=https://your-domain.ir
# Real payment gateway is configured in the admin panel (Zarinpal). The demo sandbox gateway is
# DISABLED in production unless you explicitly set:
# ALLOW_SANDBOX_GATEWAY=1
# Only for `bun run db:seed` (initial admin password; random if omitted):
# ADMIN_PASSWORD=

# Welcome wallet credit for new accounts (toman). Keep 0/unset until phone verification exists.
# SIGNUP_GIFT_AMOUNT=0
