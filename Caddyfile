:81 {
	# SECURITY: the former `XTransformPort` block let ANY visitor reach ANY local port
	# (databases, admin tools, other services) via `?XTransformPort=<port>`. Removed.
	# Put real TLS in front (Caddy automatic HTTPS with your domain) in production.

	encode zstd gzip

	handle {
		reverse_proxy localhost:3000 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}
}
